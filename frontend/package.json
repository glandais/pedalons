{
  "name": "pedalons-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "copy-legal": "mkdir -p src/assets/legal && cp ../privacy/*.md src/assets/legal/ 2>/dev/null || true",
    "predev": "pnpm copy-legal",
    "dev": "vite",
    "dev:ssr": "node server.js",
    "prebuild": "pnpm copy-legal",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "serve": "pnpm build && vite preview",
    "serve:ssr": "pnpm build && NODE_ENV=production node server.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "i18next-cli extract --quiet && prettier --write --no-cache --log-level warn \"src/**/*.{ts,tsx,css}\" \"!src/components/ui/**\" \"e2e/**/*.ts\" \"*.{ts,js,mjs,cjs}\" \"server/**/*.js\"",
    "format:check": "i18next-cli extract --ci --dry-run --quiet && prettier --check \"src/**/*.{ts,tsx,css}\" \"!src/components/ui/**\" \"e2e/**/*.ts\" \"*.{ts,js,mjs,cjs}\" \"server/**/*.js\"",
    "pretest": "pnpm copy-legal",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "tsc -p e2e --noEmit",
    "generate-api": "rm -rf src/api && orval --config orval.config.js",
    "generate-routes": "node ../scripts/generate-routes.mjs",
    "generate-brand-colors": "node ../scripts/generate-brand-colors.mjs",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:check": "i18next-cli extract --ci --dry-run && i18next-cli lint && i18next-cli status",
    "generate-icons": "pwa-assets-generator --config pwa-assets.config.ts",
    "check": "pnpm install && pnpm generate-api && pnpm generate-routes && pnpm generate-brand-colors && pnpm format && pnpm typecheck && pnpm e2e:typecheck && pnpm lint && pnpm i18n:check && pnpm build"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@mantine/schedule": "^9.7.3",
    "@mantine/tiptap": "^9.7.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@stadiamaps/maplibre-search-box": "^3.2.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "express-static-gzip": "3.0.2",
    "firebase": "^13.1.0",
    "geokdbush": "^2.1.0",
    "http-proxy-middleware": "^4.2.0",
    "i18next": "^26.5.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "kdbush": "^4.1.0",
    "maplibre-gl": "^6.15.0",
    "maplibre-theme": "^1.0.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.1",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-router-dom": "^7.18.4",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.8.0",
    "tiptap-markdown": "^0.9.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-map-gl": "^6.1.10",
    "@types/unist": "^3.0.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint-plugin-i18next": "^6.1.5",
    "i18next-cli": "^1.80.0",
    "jsdom": "^30.1.3",
    "mdast-util-directive": "^3.1.1",
    "orval": "^8.44.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
