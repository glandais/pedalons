<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pédalons</string>
	<!-- Links are handled by app_links (_DeepLinkHandler in main.dart) only. Flutter's own
	     handling pushed the route a second time, crashed while the pre-auth MaterialApp was
	     showing (no onGenerateRoute), and the engine then relayed the unhandled universal link
	     back to iOS, which opened it in Safari as well. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pédalons</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- url_launcher: schemes canLaunchUrl() must be able to probe.
	     http/https need no entry. See store-metadata/data-safety.md §5. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>webcal</string>
		<string>mailto</string>
		<string>tel</string>
	</array>
	<!-- Usage strings below are the en fallback; the localized values live in
	     Runner/{en,fr}.lproj/InfoPlist.strings. Keep the three in sync. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pédalons needs access to your photos so you can pick a profile picture, or add images to a ride you organize.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pédalons uses your approximate location only to sort rides and routes by distance from you. It is never stored or shared.</string>
	<!-- The app only ever asks for when-in-use, but the location plugin links the
	     "always" API, and App Store validation (ITMS-90683) requires the string
	     regardless of whether it is used. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Pédalons uses your approximate location only while you are using the app, to sort rides and routes by distance from you. It is never used in the background, stored or shared.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
