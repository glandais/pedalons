# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Upload a new build to Play Store internal track. Run `flutter build appbundle --release` from the project root first."
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      # "draft" was needed while the app had never been published; it left every
      # upload sitting as an undeployed draft. The app is published, so roll out.
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Push the Data safety form from store-metadata/data-safety.csv (Play Console CSV format). The API is write-only: there is no pull, so the CSV in git is the record, and a hand edit in the Console is overwritten by the next run."
  lane :data_safety do
    require "google/apis/androidpublisher_v3"
    require "googleauth"

    csv = File.read("../../store-metadata/data-safety.csv")
    key_file = CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file)
    package = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)

    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(key_file),
      scope: "https://www.googleapis.com/auth/androidpublisher",
    )
    service.data_application_safety(
      package,
      Google::Apis::AndroidpublisherV3::SafetyLabelsUpdateRequest.new(safety_labels: csv),
    )
    UI.success("Data safety form updated for #{package}")
  end

  desc "Push the store listing alone — titles, descriptions, feature graphic, icon and phone screenshots from metadata/android/ — with no build and no release. The screenshots come from mobile/screenshots/ (capture-android.sh, koubou/play.yaml, assemble-play.sh). Play then holds the change in « Vue d'ensemble de la publication » until it is sent for review. `validate:true` asks Google to check it all without committing anything."
  lane :listing do |options|
    upload_to_play_store(
      validate_only: options[:validate] == true, # `fastlane listing validate:true`: Google checks, nothing changes
      # supply looks for a release on a track even with no changelog to upload; the listing itself
      # is per app, not per track, so internal (always populated by `internal`) serves.
      track: "internal",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Deploy a new version to the Google Play production track"
  lane :deploy do
    upload_to_play_store(
      aab: "../build/app/outputs/bundle/release/app-release.aab",
    )
  end
end
