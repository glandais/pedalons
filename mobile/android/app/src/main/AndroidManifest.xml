<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Coarse location only, for the "around me" proximity filter (geolocator,
         LocationAccuracy.low → nearLat/nearLon/nearRadius). Declared in Play Data safety as
         approximate location, not retained, not linked to the account.

         ACCESS_FINE_LOCATION is deliberately NOT requested. MapLibre
         (org.maplibre.gl:android-sdk-opengl, pulled in by the `maplibre` plugin) declares it in
         its own manifest for its LocationComponent (the "user location" puck), which this app
         never enables, and the merger would inject it into ours. Left in, it would appear on the
         Play listing and over-declare against our Data safety answers, so it is stripped.
         See ../../../../store-metadata/data-safety.md §5. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove"/>

    <!-- geolocator_android (≥ 5.1) declares FOREGROUND_SERVICE_LOCATION and its
         GeolocatorLocationService for background tracking. The app only reads a one-shot coarse
         position, never starts that service, and Play refuses an upload carrying a foreground
         service permission without a matching declaration — so both are stripped. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove"/>

    <!-- Push notifications (Android 13+). Asked for from the notifications screen, never at
         launch: the system dialog is shown once and for all, and a member who has not yet seen
         what the app notifies about has no reason to say yes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Pédalons"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- See FOREGROUND_SERVICE_LOCATION above. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Links are handled by app_links (_DeepLinkHandler in main.dart) only; Flutter's
                 own handling would push every link a second time (see FlutterDeepLinkingEnabled
                 in ios/Runner/Info.plist). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- App Links for rides and routes -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.pedalons.fr" />
                <!-- BEGIN generated-deeplinks -->
                <data android:path="/" />
                <data android:path="/login" />
                <data android:path="/connexion" />
                <data android:path="/register" />
                <data android:path="/inscription" />
                <data android:path="/verify-email" />
                <data android:path="/verifier-email" />
                <data android:path="/forgot-password" />
                <data android:path="/mot-de-passe-oublie" />
                <data android:path="/reset-password" />
                <data android:path="/nouveau-mot-de-passe" />
                <data android:path="/garmin" />
                <data android:path="/karoo" />
                <data android:path="/karoo/hammerhead" />
                <data android:path="/apps" />
                <data android:path="/applications" />
                <data android:path="/privacy" />
                <data android:path="/confidentialite" />
                <data android:path="/terms" />
                <data android:path="/cgu" />
                <data android:path="/profile" />
                <data android:path="/profil" />
                <data android:path="/notifications" />
                <data android:path="/profile/rides" />
                <data android:path="/profil/sorties" />
                <data android:path="/profile/preferences" />
                <data android:path="/profil/preferences" />
                <data android:path="/profile/notifications" />
                <data android:path="/profil/notifications" />
                <data android:path="/profile/devices" />
                <data android:path="/profil/appareils" />
                <data android:path="/profile/security" />
                <data android:path="/profil/securite" />
                <data android:path="/profile/privacy" />
                <data android:path="/profil/vie-privee" />
                <data android:path="/profile/privacy/blocked" />
                <data android:path="/profil/vie-privee/bloques" />
                <data android:path="/profile/account" />
                <data android:path="/profil/compte" />
                <data android:path="/profile/help" />
                <data android:path="/profil/aide" />
                <data android:path="/calendar" />
                <data android:path="/calendrier" />
                <data android:path="/teams" />
                <data android:path="/equipes" />
                <data android:path="/teams/discover" />
                <data android:path="/equipes/decouvrir" />
                <data android:pathPattern="/teams/.*" />
                <data android:pathPattern="/equipes/.*" />
                <data android:pathPattern="/teams/.*/about" />
                <data android:pathPattern="/equipes/.*/a-propos" />
                <data android:pathPattern="/teams/.*/calendar" />
                <data android:pathPattern="/equipes/.*/calendrier" />
                <data android:pathPattern="/teams/.*/agenda" />
                <data android:pathPattern="/equipes/.*/agenda" />
                <data android:pathPattern="/teams/.*/posts" />
                <data android:pathPattern="/equipes/.*/articles" />
                <data android:pathPattern="/teams/.*/rides" />
                <data android:pathPattern="/equipes/.*/sorties" />
                <data android:pathPattern="/teams/.*/trips" />
                <data android:pathPattern="/equipes/.*/voyages" />
                <data android:pathPattern="/teams/.*/members" />
                <data android:pathPattern="/equipes/.*/membres" />
                <data android:pathPattern="/teams/.*/rides/new" />
                <data android:pathPattern="/equipes/.*/sorties/nouvelle" />
                <data android:pathPattern="/teams/.*/rides/.*" />
                <data android:pathPattern="/equipes/.*/sorties/.*" />
                <data android:pathPattern="/teams/.*/rides/.*/groups/.*" />
                <data android:pathPattern="/equipes/.*/sorties/.*/groupes/.*" />
                <data android:pathPattern="/teams/.*/rides/.*/edit" />
                <data android:pathPattern="/equipes/.*/sorties/.*/modifier" />
                <data android:pathPattern="/teams/.*/trips/.*" />
                <data android:pathPattern="/equipes/.*/voyages/.*" />
                <data android:pathPattern="/teams/.*/trips/.*/stages/.*" />
                <data android:pathPattern="/equipes/.*/voyages/.*/etapes/.*" />
                <data android:pathPattern="/teams/.*/posts/.*" />
                <data android:pathPattern="/equipes/.*/articles/.*" />
                <data android:pathPattern="/teams/.*/routes" />
                <data android:pathPattern="/equipes/.*/parcours" />
                <data android:pathPattern="/teams/.*/routes/.*" />
                <data android:pathPattern="/equipes/.*/parcours/.*" />
                <data android:pathPattern="/teams/.*/classifieds/.*" />
                <data android:pathPattern="/equipes/.*/annonces/.*" />
                <!-- END generated-deeplinks -->
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The channel FcmClient names in every message it sends. The app creates it at
             startup (PushService), so this default only catches a message that named no
             channel — but without it such a message would land in FCM's own "Miscellaneous",
             which the member cannot tell apart from any other app's stray channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pedalons_default" />
        <!-- The status bar keeps only the alpha of this icon and paints it white. The launcher
             icon would show as a white square; ic_stat_notification is the bicycle P alone
             (generated by scripts/generate-icons.sh, mobile target). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- url_launcher: without these, canLaunchUrl() returns false on API 30+ and every
             external link would silently look unlaunchable.
             See https://pub.dev/packages/url_launcher#configuration -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
