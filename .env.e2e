# End-to-end test stack — read by scripts/e2e.sh and by frontend/playwright.config.ts.
#
# Committed on purpose: every value here is a throwaway that only ever reaches containers on the
# loopback, and the database it seeds starts empty. That emptiness is the point — the local stack
# holds a biketeam restore with thousands of real addresses, and a test run sends OTPs and
# invitations. Never point this file at that database, nor the mailer at anything but mailpit.
#
# Everything is offset from the workstation stack (tribly-local) so both run side by side.

ENV_NAME=tribly-e2e
HTTP_PORT=8190
POSTGRES_HOST_PORT=15432
# mailpit's HTTP API, read by the tests to fetch OTP codes and verification links.
E2E_MAILPIT_PORT=18025
# tileserver is borrowed from the workstation stack rather than run twice. scripts/e2e.sh falls
# back to an empty network when it is not up: the stack still starts, only map tiles fail.
E2E_SHARED_NETWORK=tribly-local-shared
# No STADIAMAPS_API_KEY here, on purpose: this file is committed. docker-compose.e2e.yml takes it
# from the shell's environment -- scripts/e2e.sh reads it from the workstation's .env, the CI from a
# secret -- and without it e2e.sh exports E2E_NO_ROUTING=1 so the planner test is skipped.
# The stack does receive the real key, though: the surface computation (WEB-100, C1b) would spend
# credits on every route the suite creates. Off, it queues and sends nothing.
SURFACE_ENABLED=false

FRONTEND_SOURCEMAP=true
# Read by e2e/routes-render.e2e.ts: every screen opened on its own path must report that the SSR
# prefetch covered all its queries (frontend/src/lib/prefetchAudit.ts). Its only other effect is to
# hold link prefetching back for the first 5 s of a page load (lib/prefetch.ts).
FRONTEND_PREFETCH_AUDIT=true

PEDALONS_BOOTSTRAP_DOMAIN=localhost
PEDALONS_BOOTSTRAP_DOMAIN_NAME="Pédalons E2E"
PEDALONS_BOOTSTRAP_BASE_URL=http://localhost:8190
PEDALONS_BOOTSTRAP_ADMIN_EMAIL=admin@e2e.test
PEDALONS_BOOTSTRAP_ADMIN_DISPLAY_NAME="Admin E2E"

PUID=1000
PGID=1000

POSTGRES_DB=pedalons
POSTGRES_USER=pedalons
POSTGRES_PASSWORD=e2e-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MINIO_ROOT_USER=pedalons
MINIO_ROOT_PASSWORD=e2e-minio-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=pedalons
MINIO_SECRET_KEY=e2e-minio-secret
STORAGE_BUCKET=pedalons
DATA_CACHE_PATH=/mnt/cache

IMGPROXY_URL=http://varnish:80
TILESERVER_URL=http://tileserver:8080

CORS_ORIGINS=
ENCRYPTION_KEY=ZTJlLXRlc3Qtb25seS1lbmNyeXB0aW9uLWtleS0zMmI=

PEDALONS_PUSH_ENABLED=false

# Traefik's per-client rate limit (docs/OPERATIONS.md « Rate limiting »), lifted: nothing sets
# X-Forwarded-For in front of this stack, so every Playwright worker counts as one and the same client.
RATE_LIMIT_API_AVERAGE=100000
RATE_LIMIT_API_BURST=100000
RATE_LIMIT_FRONTEND_AVERAGE=100000
RATE_LIMIT_FRONTEND_BURST=100000

# mailpit, and nothing else: see the header.
QUARKUS_MAILER_FROM=noreply@e2e.test
QUARKUS_MAILER_HOST=mailpit
QUARKUS_MAILER_PORT=1025
QUARKUS_MAILER_START_TLS=DISABLED
QUARKUS_MAILER_LOGIN=DISABLED
