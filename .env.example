# On a deployed host the stack is a Docker Swarm stack, deployed with scripts/deploy.sh -- never a
# bare `docker stack deploy`, which does not read this file. See docs/OPERATIONS.md, Deployment.
HTTP_PORT=8090

# Traefik's per-client rate limit, requests per second and burst (docs/OPERATIONS.md « Rate
# limiting »). Unset keeps the defaults of docker-compose.yml: API 50/200, site 100/400.
#RATE_LIMIT_API_AVERAGE=50
#RATE_LIMIT_API_BURST=200
#RATE_LIMIT_FRONTEND_AVERAGE=100
#RATE_LIMIT_FRONTEND_BURST=400

# The site's Content-Security-Policy (docs/OPERATIONS.md « Content Security Policy »). Unset, it is
# only reported (Content-Security-Policy-Report-Only, violations logged by the frontend as
# `[csp-report]`); `enforce` makes browsers block what it does not allow.
#CSP_MODE=report-only
# Origins the map reaches that /api/config does not name (a style document whose sprite, glyphs or
# tiles live on another host), space-separated, e.g. https://fonts.example.org
#CSP_CONNECT_SRC_EXTRA=
ENV_NAME=pedalons-prod
# Ship frontend .js.map alongside the build (build.sh --build-arg to the Dockerfile). Set to
# true on the staging host only — leave false/unset in prod so source isn't exposed there.
FRONTEND_SOURCEMAP=false

# Log a console.warn for queries fetched after first paint that routes.config.ts's prefetch()
# didn't cover (see frontend/src/lib/prefetchAudit.ts). Read by vite.config.ts (build.sh forwards
# it as a Docker build-arg too — see Dockerfile). Safe to turn on anywhere, including staging/prod,
# since it only ever logs to the visitor's own browser console.
FRONTEND_PREFETCH_AUDIT=false

# Bootstrap: the Domain every team belongs to, and its PLATFORM_ADMIN.
# BOOTSTRAP_DOMAIN is the hostname matched against X-Forwarded-Host / Host to resolve the tenant.
# BOOTSTRAP_BASE_URL only builds absolute URLs: email links and the WebAuthn origin of passkeys.
# Both are read once, when the Domain row is created; later edits go through the admin UI.
PEDALONS_BOOTSTRAP_DOMAIN=pedalons.fr
PEDALONS_BOOTSTRAP_DOMAIN_NAME=Pédalons
PEDALONS_BOOTSTRAP_BASE_URL=https://www.pedalons.fr
PEDALONS_BOOTSTRAP_ADMIN_EMAIL=########
# Quote any value containing a space — .env is sourced by build.sh.
PEDALONS_BOOTSTRAP_ADMIN_DISPLAY_NAME="########"

# User ID/Group ID for file permissions (run: id -u && id -g)
PUID=1000
PGID=1000

# PostgreSQL
POSTGRES_DB=pedalons
POSTGRES_USER=pedalons
POSTGRES_PASSWORD=########
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Loopback port the postgres container publishes on a workstation (docker-compose.local.yml), for
# mvn quarkus:dev and a SQL client. Bump it if something else already listens on 5432. A deployed
# host publishes none.
POSTGRES_HOST_PORT=5432

# Storage (MinIO/S3)
# MinIO root credentials (used by MinIO container and all clients)
MINIO_ROOT_USER=pedalons
MINIO_ROOT_PASSWORD=########
MINIO_ENDPOINT=http://minio:9000
# Backend S3 credentials (must match MINIO_ROOT_USER/PASSWORD)
MINIO_ACCESS_KEY=pedalons
MINIO_SECRET_KEY=########
STORAGE_BUCKET=pedalons
# Map tiles and elevation data downloaded by vcyclist. Bind-mounted to ./data/cache so it survives
# `docker compose down`: refilling it means re-rendering every tile and re-fetching every elevation
# tile from tiles.mapterhorn.com.
# Must stay INSIDE the container (/mnt/cache): pointing it at /tmp silently throws the cache away on
# every restart. Two backends may use the same directory (they already do during a rolling update):
# map tiles (vcyclist >= 5.1.1) and elevation tiles (DemTileFetcher) are both written to a temp file
# then renamed, and only once they decode, so the worst case is the same tile fetched twice
# (docs/LEDGER_*.md OPS-10). Each environment still keeps its own directory.
DATA_CACHE_PATH=/mnt/cache

# Services URLs
# tileserver lives in the shared stack (docker-compose.shared.yml) on a deployed host, and in
# docker-compose.local.yml on a workstation. Either way the hostname below is its compose service
# name, so the value stays the same.
IMGPROXY_URL=http://varnish:80
TILESERVER_URL=http://tileserver:8080

# Routing (the route planner, POST /api/router): the backend calls the Stadia Maps API
# (https://api-eu.stadiamaps.com/route/v1, Valhalla-compatible, served from the EU) -- no routing container, no tiles to
# host. Get a key at https://client.stadiamaps.com/ and keep it server-side: the backend sends it in
# an `Authorization: Stadia-Auth` header. Do not rely on the dashboard's domain authentication
# (Origin/Referer): it only covers browsers, and the backend is not one. Past the plan's quota the
# API answers 429 and the planner reports an error until it resets. Required in %prod: docker-compose.yml
# restates it with :? so a deploy without it stops before any container starts. One key per environment's .env; the .env of ~/shared does not need it
# (the shared stack no longer routes). scripts/dev-env.sh exports it for `mvn quarkus:dev`.
STADIAMAPS_API_KEY=########

# Geocoding (GET /api/geocode/search, the address fields of the forms): the backend asks the Stadia
# Maps geocoder with the same STADIAMAPS_API_KEY, from the same EU host -- nothing else to configure.
# The search bar on the maps calls Stadia Maps from the browser instead, authenticated by domain
# (pedalons.fr and its subdomains are registered in the Stadia dashboard; localhost needs no key).

# Ride weather: the backend refreshes a forecast cache from Open-Meteo in the background (never
# during a request). The free endpoint needs nothing; a commercial plan is its URL plus its key,
# e.g. https://customer-api.open-meteo.com. The key travels as a query parameter and is never logged.
# OPEN_METEO_DAILY_CALL_BUDGET caps the locations asked for per UTC day (the free plan allows 10 000),
# OPEN_METEO_HOURLY_CALL_BUDGET and OPEN_METEO_PER_MINUTE_CALL_BUDGET per sliding hour and minute
# (free plan: 5 000 and 600). Raise all three with a commercial plan.
# WEATHER_ENABLED=false stops every call to the provider; cached forecasts are still shown.
#OPEN_METEO_URL=https://api.open-meteo.com
#OPEN_METEO_API_KEY=
#OPEN_METEO_DAILY_CALL_BUDGET=5000
#OPEN_METEO_HOURLY_CALL_BUDGET=4500
#OPEN_METEO_PER_MINUTE_CALL_BUDGET=500
#WEATHER_ENABLED=true
# Open-Meteo asks callers to identify themselves: a fork names itself and a way to reach it here,
# or it identifies as pedalons.fr.
#PEDALONS_USER_AGENT=Pedalons/<version> (+https://www.example.org)

# Automatic route sync to the members' GPS services (docs/LEDGER_*.md API-120), on in prod and
# staging. While false, nothing is sent, updated or removed, and the clients hide the switch — see
# docs/OPERATIONS.md, "Automatic route sync to GPS services".
#GPS_SYNC_ENABLED=false

# Surface along saved tracks (docs/LEDGER_*.md WEB-100, C1b, and OPS-57): the background computation
# by osm-surface (shared stack on a host, docker-compose.local.yml on a workstation), free, no key.
# The backend finds it at http://osm-surface:8002 (localhost:18002 in %dev); OSM_SURFACE_URL
# overrides it.
#SURFACE_ENABLED=true
#OSM_SURFACE_URL=http://osm-surface:8002
# Catch-up of the tracks saved before the surface existed (calls to osm-surface per hour)
#SURFACE_BACKFILL_ENABLED=true
#SURFACE_BACKFILL_PER_HOUR=300

# Memory limits (docker-compose.yml, deploy.resources.limits). The backend's JVM heap is 60% of
# BACKEND_MEMORY -- there is no -Xmx to keep in step. VARNISH_SIZE is its in-memory image cache: keep
# VARNISH_MEMORY about half as much again. Defaults below; a staging host can go lower
# (1G / 256M / 512M). See docs/OPERATIONS.md, Memory.
#BACKEND_MEMORY=1536M
#VARNISH_SIZE=1G
#VARNISH_MEMORY=1536M

# CORS (comma-separated origins, empty for same-origin only)
CORS_ORIGINS=

# GPS Device Integration
# Token encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=########

# Biketeam live migration -- docs/plans/2026-09-22-biketeam-live-migration.md
#
# A biketeam team admin moves their team here from biketeam's admin; biketeam and Pedalons call
# each other over the Internet, through their public HTTPS entry points (no VPN): the shared secrets
# below are the only barrier, so HTTPS is mandatory. Off unless ALL FIVE values below are set (half of them stops the backend at startup).
# Each secret: `openssl rand -base64 32`, the same value on the biketeam side (its .env.template
# names them PEDALONS_REQUEST_KEY, PEDALONS_TRIGGER_SECRET, PEDALONS_EXPORT_SECRET).
#   REQUEST_KEY     HMAC key biketeam signs the migration requests with (>= 32 bytes, base64)
#   TRIGGER_SECRET  what biketeam sends in X-Biketeam-Migration-Secret to /api/internal/
#   EXPORT_URL      biketeam's public HTTPS base URL, where its /internal/pedalons/ export lives
#   EXPORT_SECRET   what we send in X-Pedalons-Export-Secret to that export
#   PUBLIC_URL      biketeam's public site.url -- the only origin a grant is ever sent back to
PEDALONS_BIKETEAM_REQUEST_KEY=
PEDALONS_BIKETEAM_TRIGGER_SECRET=
PEDALONS_BIKETEAM_EXPORT_URL=
PEDALONS_BIKETEAM_EXPORT_SECRET=
PEDALONS_BIKETEAM_PUBLIC_URL=

# Push notifications (Firebase Cloud Messaging)
#
# Off until switched on. Put the Firebase service account JSON at data/keys/fcm-service-account.json
# (chmod 600, owned by PUID) -- next to the JWT keys, mounted read-only at /mnt/keys and saved by
# scripts/backup.sh -- then set PEDALONS_PUSH_ENABLED=true. The startup log must then say
# "Push notifications enabled -- FCM project ...": without that line the channel stayed unavailable
# (the account could not be read) and nothing is queued, but the application still starts.
# The privacy policy has to name Google (FCM) as a processor before this goes live.
# FCM_CREDENTIALS overrides the path, or holds the JSON document itself.
PEDALONS_PUSH_ENABLED=false
#FCM_CREDENTIALS=/mnt/keys/fcm-service-account.json
# Push in the browser, for the site installed as an app: the Firebase web app of the same project
# (Project settings > Your apps > Web; the VAPID key is under Cloud Messaging > Web Push
# certificates). Public values. Leave them empty and the site simply offers no notification.
#FCM_WEB_API_KEY=
#FCM_WEB_APP_ID=
#FCM_WEB_MESSAGING_SENDER_ID=
#FCM_WEB_VAPID_KEY=

# In-app feedback -> GitHub issues
#
# Bug reports, suggestions and the clients' unhandled errors are stored, then published as issues
# of a PRIVATE repository (never glandais/pedalons, which is public: an issue carries a member's words,
# device and log). Empty = nothing published, rows wait in the database.
# Token: fine-grained PAT, "Only select repositories" = that repository, permission Issues: Read and
# write, nothing else. Create the labels feedback, bug, suggestion, crash, web, android, ios first,
# plus one per domain (e.g. pedalons.fr, staging.pedalons.fr): every issue carries its domain.
# The privacy policy names GitHub as a processor.
PEDALONS_FEEDBACK_GITHUB_REPO=
PEDALONS_FEEDBACK_GITHUB_TOKEN=

# Web analytics -- GoatCounter (docs/OPERATIONS.md, « Web analytics »; ledger OPS-36)
#
# Production only. Leave all of them empty elsewhere (staging, a workstation): scripts/deploy.sh then
# runs GoatCounter at 0 replicas, and scripts/goatcounter-init.sh does nothing. deploy.sh refuses
# GOATCOUNTER_VHOST and GOATCOUNTER_DB_PASSWORD one without the other.
#   GOATCOUNTER_VHOST        the one GoatCounter site, e.g. stats.pedalons.internal: the Host every
#                            /count is rewritten to, and the only host the dashboard answers on
#                            (through an SSH tunnel; no DNS, no Caddy block)
#   GOATCOUNTER_DB_PASSWORD  the `goatcounter` database role's: `openssl rand -hex 24`, hex only
#   GOATCOUNTER_ADMIN_EMAIL  the dashboard account created by `goatcounter-init.sh site`; its
#                            password is typed at the prompt, never stored here
# The site's counter is switched on separately, by PEDALONS_ANALYTICS_COUNT_PATH=/count in the
# production .env alone, once GoatCounter's settings are in place; deploy.sh refuses it without the
# two keys above.
GOATCOUNTER_VHOST=
GOATCOUNTER_DB_PASSWORD=
GOATCOUNTER_ADMIN_EMAIL=

# Backups (scripts/backup.sh, scripts/restore.sh)
#
# The BACKUP_* settings do NOT belong here. docker-compose passes this whole file to the backend
# container (env_file), so the backup destination, the SSH key path and the Healthchecks URL would
# end up inside the application -- and inside the backup of it.
#
# They live in /root/pedalons-backup.env instead (root-only, not versioned), overridable with
# BACKUP_ENV_FILE. See "Backup and restore" in docs/OPERATIONS.md. Template:
#
#   BACKUP_REMOTE=<backup-user>@<backup-tunnel-ip>
#   BACKUP_REMOTE_PATH=/                     # relative to the rrsync root of the restricted key
#   BACKUP_SSH_KEY=/root/.ssh/id_pedalons_backup
#   BACKUP_PING_URL=https://hc-ping.com/xxxxxxxx
#   BACKUP_AGE_RECIPIENT=age1...             # required: age PUBLIC key; the private key stays offline
#   # BACKUP_SSH_PORT=2222                   # only if the destination is not on 22
#
# Restoring needs the private key as a file, for the duration of the restore only:
#   BACKUP_AGE_IDENTITY=/dev/shm/pedalons-backup.key scripts/restore.sh

# Email -- Scaleway Transactional Email (TEM), over SMTP
#
# Every e-mail is rendered by the backend (templates/mail/) and handed to this relay; TEM holds no
# template. The username is the Scaleway *project id*, the password an IAM API secret key whose
# principal has TransactionalEmailEmailFullAccess on that project, and the FROM must be on a domain
# verified in TEM (SPF, DKIM and MX records, else the relay refuses with 5xx and registration fails).
#   https://console.scaleway.com/transactional-email/domains
QUARKUS_MAILER_FROM=noreply@yourdomain.com
QUARKUS_MAILER_HOST=smtp.tem.scaleway.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_USERNAME=00000000-0000-0000-0000-000000000000
QUARKUS_MAILER_PASSWORD=########
QUARKUS_MAILER_START_TLS=REQUIRED

# --- on a workstation, add this ---------------------------------------------
#
# The stack runs the %prod profile wherever it runs, so a local copy sends real mail to real
# addresses -- including the thousands imported by a biketeam migration -- unless it is told not to.
# Point the SMTP block above at the mailpit of docker-compose.local.yml instead: it is the only way
# out for mail. And name the stack for what it is: ENV_NAME drives the container names,
# the network, the image tags and the ${ENV_NAME}-minio the backup scripts look up.
#
# COMPOSE_FILE also brings in tileserver -- a workstation runs no shared stack --
# publishes on loopback the ports `mvn quarkus:dev` and `pnpm dev` talk to, and puts backend,
# frontend and traefik behind an `app` profile, so `docker compose up -d` starts the backing services
# alone. Add `--profile app` (or COMPOSE_PROFILES=app here) to run the whole application instead.
# The dev backend reads the POSTGRES_* / MINIO_* values below through scripts/dev-env.sh.
#
#   ENV_NAME=tribly-local
#   COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
#   QUARKUS_MAILER_FROM=noreply@tribly.local
#   QUARKUS_MAILER_HOST=mailpit
#   QUARKUS_MAILER_PORT=1025
#   QUARKUS_MAILER_START_TLS=DISABLED
#   QUARKUS_MAILER_LOGIN=DISABLED
