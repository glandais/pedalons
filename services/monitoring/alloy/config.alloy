// Alloy of the monitoring stack: ships logs to Loki, nothing else (Prometheus scrapes the metrics).
// Reloaded by `scripts/deploy.sh --monitoring`.
//
// Loki labels stay few — stack, service, level for the backend, filename for Caddy — everything
// else is searched in the line (`| json`). A label per status code, path or user would multiply
// Loki's streams.

// ---- Every Swarm container on the host ------------------------------------------------------

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Stack containers only: a one-off `docker run` (restore.sh, a debugging shell) is not shipped.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    regex         = ".+"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    target_label  = "stack"
  }
  // "pedalons-prod_backend" → "backend".
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = ".+?_(.+)"
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

loki.process "containers" {
  // The backend logs JSON in %prod (quarkus-logging-json): one line per event, stack trace included.
  stage.match {
    selector = "{service=\"backend\"}"

    stage.json {
      expressions = { level = "level" }
    }
    stage.labels {
      values = { level = "" }
    }
  }

  // GoatCounter logs aligned text, one line per attribute. When it fails to store a hit (database
  // unreachable, a panic), it dumps the hit, the visitor's raw IP and user agent included, as a
  // `hit = &{…}` line, or the pending ones as `paths = …` (a dotted key, should a later version
  // expand them, is caught too). The privacy policy says the IP is never
  // kept: those lines never reach Loki (docs/plans/2026-10-15-web-analytics.md §3.1). Their format
  // may change with GoatCounter's: recheck on every upgrade, by stopping postgres for a few seconds.
  stage.match {
    selector = "{service=\"goatcounter\"}"

    stage.drop {
      expression          = "^\\s+(hit|paths)(\\.\\S+)?\\s+="
      drop_counter_reason = "goatcounter_visitor_data"
    }
  }

  forward_to = [loki.write.default.receiver]
}

// ---- The host's Caddy access logs ------------------------------------------------------------
//
// Read as Caddy wrote them: the query string is already filtered (docs/OPERATIONS.md, « Access
// logs »). One file per site, hence the filename label.

local.file_match "caddy" {
  path_targets = [{
    "__path__" = "/var/log/caddy/*-access.log",
    "job"      = "caddy",
  }]
}

loki.source.file "caddy" {
  targets    = local.file_match.caddy.targets
  forward_to = [loki.process.caddy.receiver]
}

loki.process "caddy" {
  stage.json {
    expressions = { ts = "ts" }
  }
  stage.timestamp {
    source = "ts"
    format = "unix"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
