# Keys of the monitoring stack, to add to the .env of the ~/shared checkout (its only content: the
# shared stack itself reads no variable). Read by `scripts/deploy.sh --monitoring` — see docs/OPERATIONS.md,
# « Monitoring ».

# Grafana's admin password. Only read on Grafana's very first start; change it in Grafana after.
GRAFANA_ADMIN_PASSWORD=########
# Published port, dropped on the public interface by the firewall (MONITORING_PORTS). Default 3300.
#GRAFANA_PORT=3300
# The URL Grafana is reached at: through the SSH tunnel by default.
#GRAFANA_ROOT_URL=http://localhost:3300

# Alert e-mails, through any SMTP relay (host:port, STARTTLS required).
ALERT_SMTP_SMARTHOST=smtp.example.org:587
ALERT_SMTP_USERNAME=########
ALERT_SMTP_PASSWORD=########
ALERT_SMTP_FROM=alerts@example.org
ALERT_EMAIL_TO=########
# The Healthchecks check of the Watchdog alert (period 5 min, grace 10 min): mails when the
# monitoring stack stops pinging it.
ALERT_WATCHDOG_PING_URL=https://hc-ping.com/<uuid>

# The host's Caddy metrics endpoint, as Prometheus reaches it. Default: the docker_gwbridge gateway,
# port 2020 — the Caddyfile's `:2020 { metrics }` site.
#CADDY_METRICS_TARGET=172.18.0.1:2020
